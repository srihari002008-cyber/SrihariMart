# SrihariMart Environment Configuration Template
# Copy this file to .env or create config.properties for local override

# Database Configuration (H2)
# For embedded local development:
DB_URL=jdbc:h2:./data/sriharimart;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
# For server mode deployment:
# DB_URL=jdbc:h2:tcp://localhost:9092/./data/sriharimart
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Server Configuration
SERVER_PORT=8080
SESSION_TIMEOUT_MINUTES=30

# Application Environment
APP_ENV=development
APP_NAME=SrihariMart

# AI Chatbot Configuration (Phase 3 / Week 9+)
AI_CHATBOT_PROVIDER=mock
# AI_CHATBOT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
